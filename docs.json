{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Search Service",
    "description": "Сервис полнотекстового поиска по текстам документов с использованием PostgreSQL и Elasticsearch.",
    "version": "1.0.0"
  },
  "paths": {
    "/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Поиск документов по тексту",
        "description": "Принимает произвольный текстовый запрос, ищет по тексту документа в индексе Elasticsearch и возвращает первые 20 документов со всеми полями БД, упорядоченные по дате создания.",
        "operationId": "search_posts_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Текстовый запрос для полнотекстового поиска",
              "title": "Query"
            },
            "description": "Текстовый запрос для полнотекстового поиска"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Количество возвращаемых документов (по умолчанию 20)",
              "default": 20,
              "title": "Limit"
            },
            "description": "Количество возвращаемых документов (по умолчанию 20)"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "desc",
                "asc"
              ],
              "type": "string",
              "description": "Порядок сортировки по дате создания ('desc' или 'asc')",
              "default": "desc",
              "title": "Order"
            },
            "description": "Порядок сортировки по дате создания ('desc' или 'asc')"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PostResponse"
                  },
                  "title": "Response Search Posts Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/posts/{id}": {
      "delete": {
        "tags": [
          "Posts"
        ],
        "summary": "Удаление документа по ID",
        "description": "Удаляет документ из базы данных и индекса Elasticsearch по уникальному полю id.",
