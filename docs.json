  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Общий статус сервиса ('ok' или 'degraded')"
          },
          "database": {
            "type": "boolean",
            "title": "Database",
            "description": "Статус подключения к БД"
          },
          "elasticsearch": {
            "type": "boolean",
            "title": "Elasticsearch",
            "description": "Статус подключения к Elasticsearch"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "elasticsearch"
        ],
        "title": "HealthResponse"
      },
      "PostCreate": {
        "properties": {
          "rubrics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rubrics",
            "description": "Массив рубрик документа"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text",
            "description": "Текст документа"
          },
          "created_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created Date",
            "description": "Дата создания (по умолчанию текущее время)"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "PostCreate"
      },
      "PostResponse": {
        "properties": {
          "rubrics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rubrics",
            "description": "Массив рубрик документа"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Текст документа"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "title": "Created Date",
            "description": "Дата создания документа"
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Уникальный идентификатор документа"
          }
        },
        "type": "object",
        "required": [
          "rubrics",
          "text",
          "created_date",
          "id"
        ],
        "title": "PostResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
